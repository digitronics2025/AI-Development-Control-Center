{
  "name": "ai-development-control-center",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI development orchestrator: one control center for Codex, Claude Code, tests and Git.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @acc/orchestrator --filter @acc/dashboard dev",
    "build": "pnpm --filter @acc/dashboard build && pnpm --filter @acc/orchestrator build && pnpm --filter acc-vscode build",
    "start": "node apps/orchestrator/dist/main.js",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "docs:guard": "node scripts/docs-guard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @acc/dashboard e2e",
    "e2e:cloud": "pnpm --filter @acc/dashboard e2e:cloud",
    "verify:agents": "tsx scripts/verify-agents.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm docs:guard && pnpm test",
    "demo": "node scripts/demo.mjs",
    "package:vscode": "pnpm --filter acc-vscode package",
    "cloud:test": "pnpm --filter @acc/cloud-control test",
    "cloud:dev": "pnpm --filter @acc/cloud-control dev",
    "cloud:deploy:staging": "node apps/cloud-control/scripts/deploy.mjs staging",
    "cloud:deploy:production": "node apps/cloud-control/scripts/deploy.mjs production",
    "cloud:smoke": "node apps/cloud-control/scripts/smoke.mjs production",
    "cloud:admin": "node apps/cloud-control/scripts/admin.mjs"
  },
  "devDependencies": {
    "@acc/agent-claude": "workspace:*",
    "@acc/agent-codex": "workspace:*",
    "@acc/agent-sdk": "workspace:*",
    "@acc/security": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
